pipeline {

    agent any

    triggers {
        pollSCM('H/2 * * * *')
    }


    stages {
        stage('Checkout') {
            steps {
                echo 'Checking out code from SCM...'
                checkout scm
            }
        }
        stage('Build') {
            steps {
                bat 'python aaryan.py'
            }
        }


        stage('Test') {
            steps {
                echo 'Running tests...'
            }
        }


        stage('Deploy') {
            steps {
                echo 'Deploying the application...'
            }
        }
    }
}


    
